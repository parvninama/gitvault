GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
DATABASE_PATH=./data/gitvault.sqlite
# Optional tuning (defaults shown)
# MAX_GITHUB_FILE_SIZE=94371840        # 90 MiB; do not rely on GitHub's hard 100 MB limit
# TARGET_REPOSITORY_SIZE=1073741824    # 1 GiB per repository
# MAX_REPOSITORIES=3
# STORAGE_BACKEND=local     # local (offline simulation, default) | github
# PORT=3001
# CLIENT_ORIGIN=http://localhost:5173
